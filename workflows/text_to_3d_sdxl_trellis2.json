{
  "1": {
    "inputs": {
      "ckpt_name": "RealVisXL_V5.0_fp16.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load RealVisXL V5.0" }
  },
  "2": {
    "inputs": {
      "lora_name": "sdxl_lightning_8step_lora.safetensors",
      "strength_model": 1.0,
      "model": ["1", 0]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "SDXL Lightning 8-step" }
  },
  "3": {
    "inputs": {
      "text": "a vintage brass diving helmet, single object centered, plain light gray background, studio product photo, full object visible",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive prompt" }
  },
  "4": {
    "inputs": {
      "text": "blurry, low quality, watermark, text, multiple objects, cropped, busy background",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative prompt" }
  },
  "5": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent Image" }
  },
  "6": {
    "inputs": {
      "seed": 42,
      "steps": 8,
      "cfg": 1.5,
      "sampler_name": "dpmpp_2s_ancestral",
      "scheduler": "sgm_uniform",
      "denoise": 1.0,
      "model": ["2", 0],
      "positive": ["3", 0],
      "negative": ["4", 0],
      "latent_image": ["5", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (concept image)" }
  },
  "7": {
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "8": {
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "stablegen/text3d/concept"
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save concept image" }
  },
  "9": {
    "inputs": {
      "resolution": "1024_cascade",
      "precision": "auto",
      "attn_backend": "auto"
    },
    "class_type": "LoadTrellis2Models",
    "_meta": { "title": "Load TRELLIS.2 Models" }
  },
  "10": {
    "inputs": {
      "image": ["7", 0],
      "low_vram": true
    },
    "class_type": "Trellis2RemoveBackground",
    "_meta": { "title": "Remove Background" }
  },
  "11": {
    "inputs": {
      "model_config": ["9", 0],
      "image": ["10", 0],
      "mask": ["10", 1],
      "background_color": "black"
    },
    "class_type": "Trellis2GetConditioning",
    "_meta": { "title": "Get Conditioning" }
  },
  "12": {
    "inputs": {
      "model_config": ["9", 0],
      "conditioning": ["11", 0],
      "seed": 42,
      "ss_guidance_strength": 7.5,
      "ss_sampling_steps": 12,
      "shape_guidance_strength": 7.5,
      "shape_sampling_steps": 12,
      "max_tokens": 49152
    },
    "class_type": "Trellis2ImageToShape",
    "_meta": { "title": "Image to Shape" }
  },
  "13": {
    "inputs": {
      "model_config": ["9", 0],
      "conditioning": ["11", 0],
      "shape_slat": ["12", 1],
      "subs": ["12", 2],
      "seed": 42,
      "tex_guidance_strength": 3.0,
      "tex_sampling_steps": 12
    },
    "class_type": "Trellis2ShapeToTexturedMesh",
    "_meta": { "title": "Shape to Textured Mesh" }
  },
  "14": {
    "inputs": {
      "trimesh": ["12", 0],
      "remesh": "on",
      "remesh_band": 1.0,
      "remove_inner_faces": false,
      "floater_threshold": 0.001,
      "target_face_count": 100000,
      "weld_vertices": true,
      "weld_digits": 4,
      "chart_cone_angle": 90.0,
      "chart_refine_iterations": 0,
      "chart_global_iterations": 1,
      "chart_smooth_strength": 1
    },
    "class_type": "Trellis2ProcessMesh",
    "_meta": { "title": "Process Mesh" }
  },
  "15": {
    "inputs": {
      "trimesh": ["14", 0],
      "voxelgrid": ["13", 0],
      "original_mesh": ["12", 0],
      "texture_size": 2048
    },
    "class_type": "Trellis2RasterizePBR",
    "_meta": { "title": "Rasterize PBR" }
  },
  "16": {
    "inputs": {
      "trimesh": ["15", 0],
      "filename_prefix": "stablegen/text3d/mesh",
      "file_format": "glb"
    },
    "class_type": "Trellis2ExportTrimesh",
    "_meta": { "title": "Export GLB" }
  }
}
