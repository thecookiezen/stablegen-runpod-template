{
  "1": {
    "inputs": {
      "image": "",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": { "title": "Load Input Image" }
  },
  "2": {
    "inputs": {
      "resolution": "1024_cascade",
      "precision": "auto",
      "attn_backend": "auto"
    },
    "class_type": "LoadTrellis2Models",
    "_meta": { "title": "Load TRELLIS.2 Models" }
  },
  "3": {
    "inputs": {
      "image": ["1", 0],
      "low_vram": true
    },
    "class_type": "Trellis2RemoveBackground",
    "_meta": { "title": "Remove Background" }
  },
  "4": {
    "inputs": {
      "model_config": ["2", 0],
      "image": ["3", 0],
      "mask": ["3", 1],
      "background_color": "black"
    },
    "class_type": "Trellis2GetConditioning",
    "_meta": { "title": "Get Conditioning" }
  },
  "5": {
    "inputs": {
      "model_config": ["2", 0],
      "conditioning": ["4", 0],
      "seed": 42,
      "ss_guidance_strength": 7.5,
      "ss_sampling_steps": 12,
      "shape_guidance_strength": 7.5,
      "shape_sampling_steps": 12,
      "max_tokens": 49152
    },
    "class_type": "Trellis2ImageToShape",
    "_meta": { "title": "Image to Shape" }
  },
  "6": {
    "inputs": {
      "model_config": ["2", 0],
      "conditioning": ["4", 0],
      "shape_slat": ["5", 1],
      "subs": ["5", 2],
      "seed": 42,
      "tex_guidance_strength": 3.0,
      "tex_sampling_steps": 12
    },
    "class_type": "Trellis2ShapeToTexturedMesh",
    "_meta": { "title": "Shape to Textured Mesh" }
  },
  "8": {
    "inputs": {
      "trimesh": ["5", 0],
      "remesh": "on",
      "remesh_band": 1.0,
      "remove_inner_faces": false,
      "floater_threshold": 0.001,
      "target_face_count": 100000,
      "weld_vertices": true,
      "weld_digits": 4,
      "chart_cone_angle": 90.0,
      "chart_refine_iterations": 0,
      "chart_global_iterations": 1,
      "chart_smooth_strength": 1
    },
    "class_type": "Trellis2ProcessMesh",
    "_meta": { "title": "Process Mesh" }
  },
  "9": {
    "inputs": {
      "trimesh": ["8", 0],
      "voxelgrid": ["6", 0],
      "original_mesh": ["5", 0],
      "texture_size": 2048
    },
    "class_type": "Trellis2RasterizePBR",
    "_meta": { "title": "Rasterize PBR" }
  },
  "7": {
    "inputs": {
      "trimesh": ["9", 0],
      "filename_prefix": "stablegen/trellis2",
      "file_format": "glb"
    },
    "class_type": "Trellis2ExportTrimesh",
    "_meta": { "title": "Export GLB" }
  }
}
